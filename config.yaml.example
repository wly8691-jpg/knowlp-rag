# KnowLP-Graph Configuration
# Copy this file to config.yaml and fill in your paths.
# All paths can also be set via environment variables (prefixed with KNOWLP_).

# Notes directory (REQUIRED) — any folder of Markdown files
#   Works with: Obsidian, Logseq, Joplin exports, or plain .md folder
#     Windows: "C:\\Users\\<name>\\notes"
#     Linux:   "/home/<name>/notes"
#     macOS:   "/Users/<name>/notes"
#   Or use environment variable: KNOWLP_VAULT
vault: ""

# Graph/index data directory (optional)
#   Default: "graph" under the package directory. Relative paths resolve
#   against the package dir — never against CWD, never inside the vault
#   (the vault is a read-only notes source).
#   Or use environment variable: KNOWLP_GRAPH_DIR
graph_dir: ""

# Build-time exclusions (optional)
#   exclude_dirs: skip a file if ANY path segment equals one of these dir names
#   exclude_files: skip if the vault-relative posix path matches exactly
exclude_dirs: []
exclude_files: []

# Qwen3-VL-Embedding-2B model path (optional — needed for real embedding search)
#   If empty, the system uses n-gram search (fast, no GPU required).
# PixelRAG visual search endpoints (optional — needed for image search)
#   Desktop = remote GPU machine, Local = same machine
#   Or use environment variable: KNOWLP_MODEL_PATH
#   Left empty by default = disabled (stats shows disabled); only set values if reachable
# chroma vector DB path (relative to the agent home directory)
chroma_db: "skills/.chroma/chroma.sqlite3"
#   Or use environment variable: KNOWLP_HONCHO_URL
honcho_base_url: "http://localhost:8000"
honcho_workspace: "hermes"

# PixelRAG visual search endpoints (optional — needed for image search)
#   Desktop = remote GPU machine, Local = same machine
#   Or use environment variable: KNOWLP_PIXELRAG_DESKTOP
#   Left empty = not configured (stats shows disabled); only shows unreachable when set but unreachable
pixelrag_desktop: ""
pixelrag_local: ""

# Chroma vector DB path (relative to HERMES_HOME)
chroma_db: "skills/.chroma/chroma.sqlite3"
